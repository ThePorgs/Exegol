      "title": "SystemSection",
      "type": "object"
    },
    "VolumesSection": {
      "additionalProperties": false,
      "description": "What is mounted into the container, and from where on the host.\n\nThere is deliberately no ``mount_current_dir`` / ``-cwd`` field: it expands to the\nlaunch directory, so a shared profile could bind-mount an arbitrary host tree.",
      "properties": {
        "mounts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mounts"
        },
        "workspace_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Path"
        },
        "share_exegol_resources": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share Exegol Resources"
        },
        "update_fs_perms": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Update Fs Perms"
        },
        "exegol_resources_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exegol Resources Path"
        },
        "private_workspace_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Private Workspace Path"
        }
      },
      "title": "VolumesSection",
      "type": "object"
    },
    "VpnSection": {
      "additionalProperties": false,
      "description": "VPN configuration, referenced BY PATH only.\n\nPaths are not expanded nor checked when the file is read, only at container creation.\nNo field accepts credential contents: ``auth_file`` names a file, never a secret.",
      "properties": {
        "config": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config"
        },
        "auth_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auth File"
        }
      },
      "title": "VpnSection",
      "type": "object"
    }
  },
